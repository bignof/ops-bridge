SERVICE_AGENT_IMAGE=registry.example.com/orchidea/service-agent:latest
SERVICE_AGENT_CONTAINER_NAME=service-agent
WS_URL=ws://192.168.1.100:8080/ws/agent
AGENT_ID=node-1
AGENT_KEY=your-agent-key
# key 传递方式：auto（默认，先走 X-Agent-Key 请求头，旧版 Hub 拒绝时改用 URL 参数）/ header / query
# AGENT_AUTH_MODE=auto
RECONNECT_DELAY=5
HEARTBEAT_INTERVAL=30
HEALTH_HOST=0.0.0.0
HEALTH_PORT=18081
# drain/健康检查连被管容器的 host，默认 host.docker.internal（需 compose 里的 extra_hosts 配合解析）
APP_HOST=host.docker.internal
# 本机业务服务（admin / worker）调用 Agent 本机端点的共享密钥，请求头 X-Agent-Secret 带上；odk init 每机随机生成
# 并渲染进 .env。留空时 /queryPlugin、/pluginSyncChanged、/verifyOpsCode、/envConfig、/instanceSnapshot 一律回 403
AGENT_LOCAL_SECRET=
HOST_DOCKER_SOCK=/var/run/docker.sock
MANAGED_PROJECTS_ROOT=/data
